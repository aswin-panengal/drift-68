{
  "name": "drift-break",
  "displayName": "Drift Break",
  "description": "Code. Drift. Relax. A lightweight, offline 3D drifting break in your Explorer.",
  "version": "1.1.0",
  "publisher": "drift-break-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "game",
    "drift",
    "break",
    "offline"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:driftBreak.sidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "driftBreak.sidebar",
          "name": "Drift Break",
          "visibility": "collapsed",
          "contextualTitle": "Drift Break"
        }
      ]
    },
    "commands": [
      {
        "command": "driftBreak.openEditor",
        "title": "Drift Break: Open in Editor",
        "icon": "$(screen-full)"
      },
      {
        "command": "driftBreak.openSidebar",
        "title": "Drift Break: Open in Explorer",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "driftBreak.maximize",
        "title": "Drift Break: Maximize / Restore Editor",
        "icon": "$(screen-full)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "driftBreak.openEditor",
          "when": "view == driftBreak.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "vitest run --dir tests",
    "test:browser": "python scripts/browser_test.py",
    "test:extension": "node scripts/test-extension.mjs",
    "test:workbench": "node scripts/test-extension.mjs --workbench",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "@types/vscode": "1.110.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
