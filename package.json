{
  "name": "drift-68",
  "displayName": "Drift 68",
  "description": "A lightweight 3D drifting game for coding breaks in VS Code. Play offline Solo or race a friend in online 1v1.",
  "version": "1.1.0",
  "publisher": "aswin-dev",
  "author": "Aswin Panengal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aswin-panengal/drift-break.git"
  },
  "bugs": {
    "url": "https://github.com/aswin-panengal/drift-break/issues"
  },
  "homepage": "https://github.com/aswin-panengal/drift-break#readme",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "game",
    "drift",
    "racing",
    "multiplayer",
    "offline"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:driftBreak.sidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "configuration": {
      "title": "Drift 68",
      "properties": {
        "driftBreak.multiplayer.serverUrl": {
          "type": "string",
          "default": "wss://drift-break-rooms.aswinpanengal.workers.dev",
          "scope": "application",
          "description": "Secure WebSocket origin for Drift 68 Multiplayer. Override this setting to use a different room server. Reload the window after changing it."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "driftBreak.sidebar",
          "name": "Drift 68",
          "visibility": "collapsed",
          "contextualTitle": "Drift 68"
        }
      ]
    },
    "commands": [
      {
        "command": "driftBreak.openEditor",
        "title": "Drift 68: Open in Editor",
        "icon": "$(screen-full)"
      },
      {
        "command": "driftBreak.openSidebar",
        "title": "Drift 68: Open in Explorer",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "driftBreak.maximize",
        "title": "Drift 68: Maximize / Restore Editor",
        "icon": "$(screen-full)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "driftBreak.openEditor",
          "when": "view == driftBreak.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "vitest run --dir tests",
    "test:browser": "python scripts/browser_test.py",
    "test:extension": "node scripts/test-extension.mjs",
    "test:workbench": "node scripts/test-extension.mjs --workbench",
    "worker:types": "wrangler types --config server/wrangler.jsonc server/worker-configuration.d.ts",
    "worker:check": "npm run worker:types && tsc -p server",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "licenses": "node scripts/licenses.mjs",
    "lint": "eslint src server tests scripts vite.config.ts --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "@types/vscode": "1.110.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "eslint": "10.15.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
